<AnchorPane id="AnchorPane" prefHeight="498.0" prefWidth="731.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.brainware.controller.registerController">
   <children>
